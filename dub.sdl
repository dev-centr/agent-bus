name "agent-bus"
description "Doors for an agent to drive a harness, including the one it is in"
license "MIT"
targetType "executable"
targetName "agent-bus"
dependency "d2sqlite3" version="~>1.0.0"
subConfiguration "d2sqlite3" "all-included"
preBuildCommands "tools\\copy-sqlite.cmd" platform="windows"
lflags "/LIBPATH:$PACKAGE_DIR" platform="windows"
copyFiles "sqlite3.dll" platform="windows"
